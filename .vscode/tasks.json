{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flask Development Server",
      "type": "shell",
      "command": "uv run flask --app app.main run --debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Pytest",
      "type": "shell",
      "command": "uv run pytest -q",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ruff",
      "type": "shell",
      "command": "uv run ruff check app tests scripts alembic",
      "group": "test",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
